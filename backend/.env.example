# Safety switches. Testnet is the default and strongly recommended for development.
BINANCE_TESTNET=true
ALLOW_MAINNET=false

# Binance Futures testnet credentials (required while BINANCE_TESTNET=true).
BINANCE_API_KEY_TEST=replace-with-testnet-api-key
BINANCE_API_SECRET_TEST=replace-with-testnet-api-secret

# Mainnet credentials are read only when BINANCE_TESTNET=false.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# API listener and shared token. Use a cryptographically random value.
SERVER_HOST=127.0.0.1
SERVER_PORT=8657
SERVICE_API_TOKEN=replace-with-at-least-16-random-characters
RUST_LOG=info

# Order sizing defaults.
SIZING_MARGIN_PCT=0.01
SIZING_LEVERAGE_SAFETY=0.98
SIZING_MAX_LEVERAGE=120

# Optional runtime-storage overrides (relative paths resolve from backend/).
SIZING_CONFIG_PATH=data/sizing.json
SYMBOL_REGISTRY_PATH=data/symbols.json
ICON_CACHE_DIR=data/icons
ALERTS_DB_PATH=data/alerts.sqlite3

# Optional notifications and alert deep links. Use a private topic/endpoint.
NTFY_URL=
NTFY_TOKEN=
PUBLIC_TERMINAL_URL=http://localhost:5173

# Optional CoinGecko icon provider credentials. Configure at most one.
COINGECKO_DEMO_API_KEY=
COINGECKO_PRO_API_KEY=

# Optional variables consumed by the telegram-notify integration when enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
