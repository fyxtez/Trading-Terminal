# Local development backend. Vite embeds every VITE_* value in the client bundle.
VITE_TRADING_API_URL=http://127.0.0.1:8657
VITE_TRADING_LOCAL_API_URL=http://127.0.0.1:8657

# Must match backend SERVICE_API_TOKEN for the current private/local auth model.
# Generate a unique random value; never use this placeholder in a deployment.
VITE_TRADING_API_TOKEN=replace-with-the-same-random-token

# Base URL used when alert notifications link back to a chart.
VITE_PUBLIC_TERMINAL_URL=http://localhost:5173
