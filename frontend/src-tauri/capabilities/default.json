{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main Fyxtez native window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPCACHE/fyxtez-backup-export.fyxtez-backup" },
        { "path": "$APPCACHE/fyxtez-backup-import.fyxtez-backup" }
      ]
    }
  ]
}
